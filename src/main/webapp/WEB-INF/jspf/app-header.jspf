<header class="topbar app-topbar">
  <div class="title">
    <h1><c:out value="${requestScope.pageTitle}"/></h1>
    <p><c:out value="${requestScope.pageSubtitle}"/> <span id="todayDate"></span></p>
  </div>
  <div class="top-actions app-top-actions">
    <label class="app-search" aria-label="Search placeholder">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
      <input type="search" placeholder="Search your flow" aria-label="Search your flow" readonly>
    </label>
    <a class="icon-btn" href="${ctx}/coming-soon.jsp?feature=Notifications" title="Notifications" aria-label="Notifications, coming soon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
    </a>
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to dark mode" title="Switch theme">
      <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
      <span class="theme-toggle-label">Dark</span>
    </button>
    <a class="header-profile" href="${ctx}/profile" aria-label="Open profile">
      <span class="header-avatar"><c:out value="${sessionScope.user.fullName.substring(0,1)}"/></span>
      <span class="header-profile-copy"><b><c:out value="${sessionScope.user.fullName}"/></b><small>My profile</small></span>
    </a>
  </div>
</header>
