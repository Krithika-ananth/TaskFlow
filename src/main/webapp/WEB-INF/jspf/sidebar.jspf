<aside class="sidebar" id="sidebar">
  <a class="brand" href="${ctx}/dashboard">
    <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17.5V6.8c0-.5.4-.8.9-.8h4.4a6 6 0 1 1 0 12H5Z"/><path d="M8 14.4c2.4-2.6 4.9-4.2 8.2-5.3"/><path d="m14.2 8.5 2.5.6-.3 2.5"/></svg></span><span>TASK FLOW</span>
  </a>
  <a class="profile-mini" href="${ctx}/profile" aria-label="Open your profile">
    <span class="avatar"><c:out value="${sessionScope.user.fullName.substring(0,1)}"/></span>
    <span class="profile-mini-copy"><strong><c:out value="${sessionScope.user.fullName}"/></strong><small>Personal workspace</small></span>
  </a>
  <div class="nav-label">Workspace</div>
  <nav class="sidebar-links" aria-label="Main navigation">
    <a href="${ctx}/dashboard" class="nav-link ${pageContext.request.servletPath=='/dashboard'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/></svg></span><span>Dashboard</span></a>
    <a href="${ctx}/tasks" class="nav-link ${(pageContext.request.servletPath=='/tasks' or pageContext.request.servletPath=='/tasks.jsp') and collection!='SHARED'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8 12 2.2 2.2L16 8.5"/></svg></span><span>My Tasks</span></a>
    <a href="${ctx}/tasks?collection=SHARED" class="nav-link ${(pageContext.request.servletPath=='/tasks' or pageContext.request.servletPath=='/tasks.jsp') and collection=='SHARED'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3 2.3-5 6-5s6 2 6 5M15 15c3.5-.2 5.5 1.4 6 4"/></svg></span><span>Shared With Me</span></a>
    <a href="${ctx}/calendar" class="nav-link ${pageContext.request.servletPath=='/calendar'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></span><span>Calendar</span></a>
    <a href="${ctx}/history" class="nav-link ${pageContext.request.servletPath=='/history'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 1 0 2.3-5.6L4 8.7"/><path d="M4 4v4.7h4.7M12 7v5l3 2"/></svg></span><span>History</span></a>
    <a href="${ctx}/pomodoro" class="nav-link ${pageContext.request.servletPath=='/pomodoro'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="13" r="7"/><path d="M12 9v4l2.5 2M9 3h6"/></svg></span><span>Focus</span></a>
    <a href="${ctx}/statistics" class="nav-link ${pageContext.request.servletPath=='/statistics' or pageContext.request.servletPath=='/statistics.jsp'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 19V9M12 19V5M19 19v-7"/></svg></span><span>Statistics</span></a>
    <a href="${ctx}/achievements" class="nav-link ${pageContext.request.servletPath=='/achievements' or pageContext.request.servletPath=='/achievements.jsp'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 4h8v5a4 4 0 0 1-8 0zM8 6H5v2a3 3 0 0 0 3 3M16 6h3v2a3 3 0 0 1-3 3M12 13v4M8 20h8"/></svg></span><span>Achievements</span></a>
    <a href="${ctx}/friends" class="nav-link ${pageContext.request.servletPath=='/friends' or pageContext.request.servletPath=='/friends.jsp'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3 19c0-3 2.5-5 6-5s6 2 6 5M17 5a3 3 0 0 1 0 6M18 14c2 .6 3 2.2 3 4"/></svg></span><span>Friends</span></a>
    <a href="${ctx}/resources" class="nav-link ${pageContext.request.servletPath=='/resources'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21zM4 5.5v13A2.5 2.5 0 0 1 6.5 16H20"/></svg></span><span>Resources</span></a>
    <a href="${ctx}/coming-soon.jsp?feature=Notifications" class="nav-link"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></span><span>Notifications</span></a>
    <a href="${ctx}/settings" class="nav-link ${pageContext.request.servletPath=='/settings'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.3-2l1.3-1.2-2-2-1.3 1.3a7 7 0 0 0-2-.8L12.5 5h-2l-.3 2.3a7 7 0 0 0-2 .8L6.9 6.8l-2 2 1.3 1.2a7 7 0 0 0-.3 2l-1.7.7v2.6l1.7.7a7 7 0 0 0 .3 2l-1.3 1.2 2 2 1.3-1.3a7 7 0 0 0 2 .8l.3 2.3h2l.3-2.3a7 7 0 0 0 2-.8l1.3 1.3 2-2-1.3-1.2a7 7 0 0 0 .3-2l1.7-.7v-2.6z"/></svg></span><span>Settings</span></a>
  </nav>
  <div class="sidebar-bottom">
    <a href="${ctx}/profile" class="logout ${pageContext.request.servletPath=='/profile'?'active':''}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c.6-3.5 3.3-5.5 7.5-5.5s6.9 2 7.5 5.5"/></svg></span><span>Profile</span></a>
    <a href="${ctx}/logout" class="logout"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 5H5v14h5M14 8l4 4-4 4M9 12h9"/></svg></span><span>Logout</span></a>
  </div>
</aside>
<button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
<nav class="mobile-nav" aria-label="Mobile navigation">
