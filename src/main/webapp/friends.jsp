<%@ include file="/WEB-INF/jspf/header.jspf" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Task Flow | Friends</title><script src="${pageContext.request.contextPath}/js/theme-init.js?v=20260927-polish"></script><link rel="stylesheet" href="${ctx}/css/style.css?v=20260927-polish"></head><body><div class="app"><%@ include file="/WEB-INF/jspf/sidebar.jspf" %><main class="main">
<c:set var="pageTitle" value="Friends" scope="request"/><c:set var="pageSubtitle" value="Connect with people you know. Your tasks stay private." scope="request"/><%@ include file="/WEB-INF/jspf/app-header.jspf" %>
<c:if test="${not empty param.message}"><div class="task-notice" role="status"><c:choose><c:when test="${param.message=='self'}">You can't send a friend request to yourself.</c:when><c:when test="${param.message=='already-friends'}">You're already friends.</c:when><c:when test="${param.message=='sent'}">Friend request sent.</c:when><c:when test="${param.message=='incoming'}">This person already sent you a request. You can respond below.</c:when><c:when test="${param.message=='accepted'}">Friend request accepted.</c:when><c:when test="${param.message=='rejected'}">Friend request declined.</c:when><c:when test="${param.message=='removed'}">Friend removed.</c:when><c:otherwise>That request is no longer available.</c:otherwise></c:choose></div></c:if>
<c:if test="${not empty publicProfile}"><section class="card public-profile"><span class="avatar"><c:out value="${publicProfile.fullName.substring(0,1)}"/></span><div><h2><c:out value="${publicProfile.fullName}"/></h2><p>@<c:out value="${publicProfile.username}"/></p></div><a class="pill" href="${ctx}/friends">Back to Friends</a></section></c:if>
<div class="friends-grid"><section class="card"><div class="table-head"><h2 class="section-title">Find People</h2></div><form class="friend-search" method="get" action="${ctx}/friends"><label class="sr-only" for="friendSearch">Search by username or name</label><input class="search" id="friendSearch" name="q" value="<c:out value='${query}'/>" placeholder="Search by username or name..." maxlength="60"><button class="btn primary" type="submit">Search</button></form>
<c:if test="${not empty query}"><div class="friend-results"><c:choose><c:when test="${empty results}"><div class="empty"><strong>No people found.</strong><br>Try another username or name.</div></c:when><c:otherwise><c:forEach var="person" items="${results}"><article class="friend-card"><span class="avatar"><c:out value="${person.fullName.substring(0,1)}"/></span><div class="friend-card-main"><strong><c:out value="${person.fullName}"/></strong><small>@<c:out value="${person.username}"/></small></div><c:choose><c:when test="${person.relationshipState=='FRIENDS'}"><span class="pill friend-state">Friends</span></c:when><c:when test="${person.relationshipState=='SENT'}"><span class="pill friend-state">Request Sent</span></c:when><c:when test="${person.relationshipState=='RECEIVED'}"><span class="pill friend-state">Request received below</span></c:when><c:otherwise><form method="post" action="${ctx}/friends"><input type="hidden" name="action" value="send"><input type="hidden" name="userId" value="${person.userId}"><button class="btn secondary" type="submit">Add Friend</button></form></c:otherwise></c:choose></article></c:forEach></c:otherwise></c:choose></div></c:if>
</section><section class="card"><div class="table-head"><h2 class="section-title">Friend Requests</h2><span class="badge medium">${incoming.size()}</span></div><c:choose><c:when test="${empty incoming}"><div class="empty">No pending friend requests.</div></c:when><c:otherwise><c:forEach var="request" items="${incoming}"><article class="friend-card"><span class="avatar"><c:out value="${request.fullName.substring(0,1)}"/></span><div class="friend-card-main"><strong><c:out value="${request.fullName}"/></strong><small>@<c:out value="${request.username}"/> wants to connect with you</small></div><div class="friend-actions"><form method="post" action="${ctx}/friends"><input type="hidden" name="action" value="accept"><input type="hidden" name="requestId" value="${request.requestId}"><button class="btn primary" type="submit">Accept</button></form><form method="post" action="${ctx}/friends"><input type="hidden" name="action" value="reject"><input type="hidden" name="requestId" value="${request.requestId}"><button class="btn secondary" type="submit">Reject</button></form></div></article></c:forEach></c:otherwise></c:choose></section></div>
<section class="card friends-list"><div class="table-head"><h2 class="section-title">My Friends</h2><span class="muted">${friends.size()} friends</span></div><c:choose><c:when test="${empty friends}"><div class="empty">You haven't added any friends yet.<br>Find someone by username to get started.</div></c:when><c:otherwise><div class="friend-list"><c:forEach var="friend" items="${friends}"><article class="friend-card"><span class="avatar"><c:out value="${friend.fullName.substring(0,1)}"/></span><div class="friend-card-main"><strong><c:out value="${friend.fullName}"/></strong><small>@<c:out value="${friend.username}"/></small></div><div class="friend-actions"><a class="pill" href="${ctx}/friends?profile=${friend.userId}">View Profile</a><form method="post" action="${ctx}/friends"><input type="hidden" name="action" value="remove"><input type="hidden" name="userId" value="${friend.userId}"><button class="pill remove-friend" type="submit" data-confirm="Remove <c:out value='${friend.fullName}'/> from your friends?">Remove</button></form></div></article></c:forEach></div></c:otherwise></c:choose></section>
<footer class="app-footer">Your tasks, calendar, reminders and history remain private.</footer></main></div><script src="${ctx}/js/app.js?v=20260927-polish"></script></body></html>
