<%@ include file="/WEB-INF/jspf/header.jspf" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><title>Task Flow | Focus Timer</title><meta name="viewport" content="width=device-width,initial-scale=1"><script src="${pageContext.request.contextPath}/js/theme-init.js?v=20260927-polish"></script><link rel="stylesheet" href="${ctx}/css/style.css?v=20260927-polish"></head><body><div class="app"><%@ include file="/WEB-INF/jspf/sidebar.jspf" %><main class="main">
<c:set var="pageTitle" value="Focus Timer" scope="request"/><c:set var="pageSubtitle" value="Protect one block of time and do the work that matters." scope="request"/><%@ include file="/WEB-INF/jspf/app-header.jspf" %>
<section class="card timer"><div class="timer-shell"><div class="timer-face"><div><strong id="time">25:00</strong><small style="display:block;color:var(--muted);margin-top:5px">Focus Time</small></div></div><div class="timer-actions"><button class="btn primary" onclick="startTimer()">Start</button><button class="btn secondary" onclick="pauseTimer()">Pause</button><button class="btn danger" onclick="resetTimer()">Reset</button></div><div class="mode-tabs"><button class="pill active" onclick="setMode(1500,this)">Focus</button><button class="pill" onclick="setMode(300,this)">Short Break</button><button class="pill" onclick="setMode(900,this)">Long Break</button></div><p style="color:var(--muted);font-size:11px;margin-top:18px">Completed focus sessions: <b id="sessions">0</b></p><p style="color:var(--muted);font-size:10px">The legacy Java Applet source remains isolated in <code>webapp/legacy</code> for the academic requirement.</p></div></section>
<footer class="app-footer">&#169; 2026 Task Flow</footer></main></div><script>let sec=1500,timer=null,sessions=0;function draw(){const m=String(Math.floor(sec/60)).padStart(2,'0'),s=String(sec%60).padStart(2,'0');document.getElementById('time').textContent=m+':'+s}function startTimer(){if(timer)return;timer=setInterval(()=>{if(sec>0){sec--;draw()}else{clearInterval(timer);timer=null;sessions++;document.getElementById('sessions').textContent=sessions;alert('Focus session complete. Great work!')}},1000)}function pauseTimer(){clearInterval(timer);timer=null}function resetTimer(){pauseTimer();sec=1500;draw()}function setMode(v,el){pauseTimer();sec=v;draw();document.querySelectorAll('.mode-tabs .pill').forEach(x=>x.classList.remove('active'));el.classList.add('active')}draw();</script></body></html>
