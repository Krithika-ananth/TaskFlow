<%@ include file="/WEB-INF/jspf/header.jspf" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><title>Task Flow | Settings</title><meta name="viewport" content="width=device-width,initial-scale=1"><script src="${pageContext.request.contextPath}/js/theme-init.js?v=20260927-polish"></script><link rel="stylesheet" href="${ctx}/css/style.css?v=20260927-polish"></head><body><div class="app"><%@ include file="/WEB-INF/jspf/sidebar.jspf" %><main class="main">
<c:set var="pageTitle" value="Your Task Flow" scope="request"/><c:set var="pageSubtitle" value="Manage your profile, security and preferences." scope="request"/><%@ include file="/WEB-INF/jspf/app-header.jspf" %>
<c:if test="${not empty error}"><div class="alert"><c:out value="${error}"/></div></c:if>
<div class="grid layout-2"><section class="card"><h3 class="section-title">Profile</h3><form method="post" action="${ctx}/settings"><input type="hidden" name="action" value="profile"><div class="field"><label for="settingsFullName">Full Name</label><input id="settingsFullName" name="fullName" value="${sessionScope.user.fullName}" required maxlength="120"></div><div class="field" style="margin-top:12px"><label for="settingsEmail">Email</label><input id="settingsEmail" value="${sessionScope.user.email}" disabled></div><button class="btn primary" style="margin-top:15px">Save Changes</button></form></section>
<section class="card"><h3 class="section-title">Preferences</h3><div class="task-row"><div class="task-info"><strong>Theme</strong><small>Choose light or dark appearance.</small></div><select class="pill" id="themePreference" aria-label="Color theme"><option value="light">Light</option><option value="dark">Dark</option></select></div><div class="task-row"><div class="task-info"><strong>Default priority</strong><small>Used when you create a new task.</small></div><select class="pill" aria-label="Default task priority"><option>Medium</option><option>High</option><option>Low</option></select></div><div class="task-row"><div class="task-info"><strong>Notifications</strong><small>Task reminders and productivity updates.</small></div><input type="checkbox" checked aria-label="Enable notifications"></div></section></div>
<div class="grid layout-2" style="margin-top:17px"><section class="card"><h3 class="section-title">Security</h3><form method="post" action="${ctx}/settings"><input type="hidden" name="action" value="password"><div class="field"><label>Current password</label><input type="password" name="oldPassword" required></div><div class="field" style="margin-top:10px"><label>New password</label><input type="password" name="newPassword" required></div><div class="field" style="margin-top:10px"><label>Confirm new password</label><input type="password" name="confirmPassword" required></div><button class="btn secondary" style="margin-top:12px">Change Password</button></form><a class="btn secondary" href="${ctx}/logout" style="margin-top:10px">Logout</a><form method="post" action="${ctx}/settings" style="display:inline"><input type="hidden" name="action" value="delete"><button class="btn danger" style="margin:10px 0 0 8px" data-confirm="Delete your account and all personal data? This cannot be undone.">Delete Account</button></form></section>
<section class="card privacy"><h3 class="section-title">Privacy First</h3><b>Your tasks belong to you.</b><p style="font-size:12px;line-height:1.7">Only you can access your personal productivity data. Task Flow has no administrator dashboard, no faculty portal and no shared task pages.</p></section></div>
<footer class="app-footer">&#169; 2026 Task Flow</footer></main></div><script src="${ctx}/js/app.js?v=20260927-polish"></script></body></html>
